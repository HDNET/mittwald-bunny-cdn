{
  "name": "mittwald-bunny-cdn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "mStudio-Extension zur BunnyCDN-Integration für TYPO3-Projekte. EU-basierter CDN-Betreiber (bunny.net, Sitz Slowenien) für DSGVO-konforme Auslieferung ohne US-Cloud-Act-Risiko. Setup-Wizard, automatische DNS-Konfiguration, TYPO3-Edge-Rules für eingeloggte Frontend-User, Origin-Entlastung durch Caching an Edge-PoPs.",
  "keywords": [
    "mittwald",
    "mstudio-extension",
    "bunny-cdn",
    "cdn",
    "typo3",
    "eu",
    "dsgvo",
    "gdpr",
    "sovereignty"
  ],
  "homepage": "https://github.com/HDNET/mittwald-bunny-cdn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HDNET/mittwald-bunny-cdn.git"
  },
  "bugs": {
    "url": "https://github.com/HDNET/mittwald-bunny-cdn/issues"
  },
  "author": {
    "name": "HDNET GmbH & Co. KG",
    "url": "https://www.hdnet.de"
  },
  "contributors": [
    {
      "name": "Carsten Hensiek",
      "email": "carsten.hensiek@hdnet.de"
    }
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "h3": "^2.0.1-rc.15",
    "srvx": "^0.11.13",
    "picomatch@^4": "^4.0.4"
  },
  "scripts": {
    "dev": "vite dev --host --port 3000",
    "dev:expose": "dotenv -- bash -c 'sudo zrok share reserved $ZROK_RESERVED_TOKEN'",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "dev:iframe": "npm run build && node --env-file=.env .output/server/index.mjs",
    "routes:generate": "tsr generate",
    "typecheck": "npm run routes:generate && tsc --noEmit",
    "code-check": "biome check .",
    "code-fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "postinstall": "npm rebuild better-sqlite3 && patch-package",
    "prepare": "husky"
  },
  "dependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "@mittwald/api-client": "^4.445.0",
    "@mittwald/ext-bridge": "^0.2.0-alpha.812",
    "@mittwald/flow-remote-react-components": "^0.2.0-alpha.812",
    "@mittwald/mstudio-ext-react-components": "^0.2.0-alpha.812",
    "@mittwald/react-ghostmaker": "^1.5.4",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/router-plugin": "^1.139.0",
    "@tanstack/start-client-core": "^1.167.17",
    "@weissaufschwarz/mitthooks": "0.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "envalid": "^8.2.0",
    "i18next": "^26.4.0",
    "nitro": "^3.0.260429-beta",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.12",
    "react-is": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@hdnet/commitlint-config": "^1.0.2",
    "@tanstack/router-cli": "^1.167.33",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "patch-package": "^8.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.5"
  }
}
